# Sao chép thành file `.env` (đã được khai báo trong pubspec assets).
# Thời gian chờ tối đa mỗi request (giây), tránh treo UI khi DNS/mạng lỗi.
API_REQUEST_TIMEOUT_SECONDS=15
# Phải trùng **chính xác** host trong Swagger (chú ý robotmm vs robotmn — lệch 1 ký tự là DNS lỗi).
API_BASE_URL=https://api.robotmm88.com
# Nếu Request URL trong Swagger là https://host/api/auth/... thì đặt: API_PATH_PREFIX=/api
# Nếu Swagger ghi https://host/auth/... thì để trống hoặc API_PATH_PREFIX=
API_PATH_PREFIX=
API_LOGIN_PATH=/auth/login
API_REGISTER_PATH=/auth/register
API_SUBTRACT_COINS_PATH=/users/subtract-coins-for-action
# Trừ xu khi bấm Tính toán (overlay)
SUBTRACT_COINS_AMOUNT=1000
SUBTRACT_COINS_ACTION=PLAY_GAME
# Gợi ý mặc định mã quản trị khi đăng ký (managedByAdmin, vd. A2B9) — có thể để trống
DEFAULT_MANAGED_BY_ADMIN=
